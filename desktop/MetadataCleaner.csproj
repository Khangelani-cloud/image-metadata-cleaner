<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Image Metadata Cleaner</AssemblyName>
    <RootNamespace>ImageMetadataCleaner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version Condition="'$(Version)' == ''">1.1.0</Version>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''"></UpdateRepository>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepository</_Parameter1>
      <_Parameter2>$(UpdateRepository)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
